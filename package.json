{
  "name": "bibliolisa",
  "private": true,
  "version": "0.2.1",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @bibliolisa/server dev",
    "dev:web": "pnpm --filter @bibliolisa/web dev",
    "docker:build": "docker build -t bibliolisa:local .",
    "docker:smoke": "node scripts/docker-smoke-test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
