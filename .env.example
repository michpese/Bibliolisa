# Bibliolisa Server Environment Configuration

# HTTP server binding (container / host)
PORT=3000
HOST=0.0.0.0

# Docker Compose: Host-Port & Bind-Adresse (nicht 80/443 – dort läuft der bestehende Host-Reverse-Proxy)
# HOST_BIND=127.0.0.1 -> nur über den Host-Proxy erreichbar, 0.0.0.0 -> zusätzlich direkt im LAN
HOST_PORT=3000
HOST_BIND=0.0.0.0

# Persistent data directory for SQLite database and cached book covers
# (Docker: /data, Host-Verzeichnis ./data muss UID 10001 gehören)
DATA_DIR=./data

# Optional: Verzeichnis des gebauten Webapp-Bundles (Docker: /app/public, Standard: web/dist)
# WEB_DIR=

# Signing secret for JWT access and media tokens (minimum 32 characters!)
JWT_SECRET=replace-with-at-least-32-random-characters

# Reverse proxy support (must be true behind Nginx / Caddy / Traefik)
TRUST_PROXY=true

# Allow public self-registration via POST /api/auth/register
ALLOW_REGISTRATION=true

# Optional external metadata API keys
HARDCOVER_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Fastify/Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
