{
  "expo": {
    "name": "Bibliolisa",
    "slug": "bibliolisa",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5"
    },
    "android": {
      "package": "de.bibliolisa.mobile",
      "versionCode": 20099,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f46e5"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Bibliolisa benötigt Zugriff auf die Kamera zum Scannen von ISBN-Barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bibliolisa benötigt Zugriff auf Fotos zur Auswahl eigener Buchcover.",
          "cameraPermission": "Bibliolisa benötigt Zugriff auf die Kamera zum Fotografieren von Buchcovern."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "./plugins/withLanNetworkSecurity",
      "./plugins/withAndroidReleaseSigning"
    ]
  }
}
